# ===== 搜索 API（必填，见 README §7.3）=====
# 提供方：serpapi / bing / tavily / bocha
SEARCH_API_PROVIDER=

SEARCH_API_KEY=

# ===== LLM 总结 API（必填，见 README §7.3）=====
# 支持 OpenAI 兼容协议；境内客户优先境内合规模型（README §11）
LLM_API_KEY=
LLM_BASE_URL=

LLM_MODEL=

# ---- 示例（仅供参考）----
# SERPAPI:
#   SEARCH_API_PROVIDER=serpapi
#   SEARCH_API_KEY=<your-serpapi-key>
# OpenAI 兼容:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
# 境内模型（示例）:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat