          "title": "Category",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "query",
        "category",
        "reason"
      ],
      "title": "Gap",
      "type": "object"
    },
    "RawResult": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "published_at": {
          "title": "Published At",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "api": {
          "title": "Api",
          "type": "string"
        },
        "fetched_at": {
          "title": "Fetched At",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "snippet",
        "published_at",
        "source",
        "query",
        "category",
        "api",
        "fetched_at"
