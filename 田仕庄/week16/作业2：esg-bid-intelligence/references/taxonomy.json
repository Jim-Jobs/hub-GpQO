  "amount": {
    "_doc": "金额解析优先级：先按 labeled 正则抓带标签的金额，抓不到再退回表格首行金额。exclude 命中的上下文直接丢弃，避免把代理服务费/预算价当中标价。",
    "labeled_patterns": [
      "中标[（(]?成交[）)]?金额[^0-9]{0,12}([0-9][0-9,，\\.]*)\\s*(万元|元)",
      "中标金额[^0-9]{0,12}([0-9][0-9,，\\.]*)\\s*(万元|元)",
      "成交金额[^0-9]{0,12}([0-9][0-9,，\\.]*)\\s*(万元|元)",
      "中标[（(]成交[）)]?价[^0-9]{0,12}([0-9][0-9,，\\.]*)\\s*(万元|元)",
      "合同金额[^0-9]{0,12}([0-9][0-9,，\\.]*)\\s*(万元|元)"
    ],
    "exclude_context": [
      "代理服务费",
      "代理费",
      "服务费",
      "预算金额",
      "最高限价",
      "控制价",
      "保证金",
      "评审得分",
      "得分"
    ],
    "unit": "元"
  },

