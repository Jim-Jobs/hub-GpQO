# LLM 配置（OpenAI 兼容接口）
# 智谱 GLM：https://open.bigmodel.cn/api/paas/v4
# key 格式：xxxxxxxxxxxxxxxx.yyyyyyyyyyyy
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_api_key_here
# 主模型：生成/修正 SQL（质量关键路径）
LLM_MODEL=glm-4.5-air
# 辅助模型：改写/评审/组织回答（留空=与主模型一致）
LLM_FAST_MODEL=
# 思维链开关：auto（GLM-4.5+ 自动关闭）/ enabled / disabled
# 关闭后同质量下单次调用快 3~12 倍，是本项目最主要的性能开关
LLM_THINKING=auto
LLM_MAX_RETRIES=1
# 后端：native（默认，httpx 直连，冷启动快约 2s）/ langchain
LLM_BACKEND=native

# 数据库
DATABASE_URL=sqlite:///chinook.db

# Agent 行为
MAX_RETRIES=3
MAX_RESULT_ROWS=50
REQUEST_TIMEOUT=60
QUERY_TIMEOUT=10

# 评审回路（Reflection 模式：评审把关 + 按需改写）
ENABLE_QUERY_REVIEW=true
# on_revise（默认，省一次调用）：write → review →(revise) optimize → review
# always（兼容旧行为）：      write → optimize → review
OPTIMIZE_STRATEGY=on_revise
MAX_OPTIMIZE_ROUNDS=2

# 性能
STREAM_ANSWER=true
SCHEMA_SAMPLE_ROWS=2

# 日志（级别：DEBUG/INFO/WARNING；文件按 1MB 滚动保留 3 份）
LOG_LEVEL=INFO
LOG_FILE=logs/sql_agent.log
