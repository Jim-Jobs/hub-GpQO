# ============================================================
# 大模型（Qwen / DashScope）—— 三套 LLM 客户端共用这组配置
# ============================================================
# 必填：百炼控制台创建。代码中一律从环境变量读取，禁止硬编码
DASHSCOPE_API_KEY=sk-your-key-here
# OpenAI 兼容端点；AsyncOpenAI、ChatOpenAI、OpenAIChatCompletionsModel 共用
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称；情感识别与回复生成共用
QWEN_MODEL=qwen-flash
# 单次模型调用超时（秒）
LLM_TIMEOUT_SECONDS=30
# 单条输入最大字符数（按 trim 后长度校验）
MAX_INPUT_LENGTH=4000

# ============================================================
# 编排引擎：langgraph | openai-agents
# 非法取值启动即失败（fail fast），不做静默回退
# ============================================================
PIPELINE_ENGINE=langgraph

# ============================================================
# 数据库
# ============================================================
# 本地直连：密码必须与下方 DB_PASSWORD 一致；Docker 部署时由 compose 注入，主机名必须是 db
DATABASE_URL=postgresql+asyncpg://app:change-me@127.0.0.1:5432/sentiment_chat
# 初始化 PG 密码；本地 DATABASE_URL 与 Docker 注入均使用该值
# 请使用 URL-safe 字符（字母、数字、-、_），避免 @ : / ? # 等
DB_PASSWORD=change-me

# ============================================================
# API 访问控制（可选）
# ============================================================
# 留空：仅依赖回环端口绑定，适合本机演示
# 设置后：/chat 与历史接口必须携带 X-API-Token 头，至少 16 字符
API_TOKEN=

# ============================================================
# 日志
# ============================================================
LOG_LEVEL=INFO
