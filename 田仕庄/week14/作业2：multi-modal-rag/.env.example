# 复制为 .env 使用（.env 不入库）

# 全 mock：不连 Kafka / Milvus / MinerU / LLM
RAG_MOCK_EXTERNAL=0
RAG_PARSE_BACKEND=mineru

# 数据与日志（日志独立目录）
RAG_DATA_DIR=./data
RAG_LOG_DIR=./data/logs
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=0
RAG_LOG_MAX_BYTES=10485760
RAG_LOG_BACKUP_COUNT=5

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=rag-data
RAG_KAFKA_GROUP_ID=rag-parse-workers
RAG_KAFKA_MAX_POLL_INTERVAL_MS=1800000

# MinerU（可降级 pipeline / mock）
RAG_MINERU_BACKEND=vlm-http-client
MINERU_BACKEND_URL=http://127.0.0.1:30000
RAG_MINERU_CLI_PATH=
RAG_MINERU_CLI_MODE=v4
RAG_MINERU_TIER=flash
RAG_MINERU_SERVER_URL=http://127.0.0.1:15980
RAG_PARSE_TIMEOUT_SEC=900
RAG_PARSE_RETRIES=2
RAG_WORKER_RETRY_BASE_SEC=5
RAG_WORKER_POLL_INTERVAL_SEC=1
RAG_WORKER_DLQ_PATH=./data/logs/worker_dlq.jsonl

# Milvus：RAG_MILVUS_URI 优先（本地文件=Milvus Lite；http=standalone）
RAG_MILVUS_URI=
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_data_new

# 模型
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
VL_MODEL=qwen3-vl-plus
BGE_MODEL_PATH=
CLIP_MODEL_PATH=
BGE_DIM=512
CLIP_DIM=512
RAG_EMBED_BATCH_SIZE=16

# 上传与图片
RAG_MAX_UPLOAD_FILES=20
RAG_MAX_UPLOAD_BYTES=52428800
RAG_MAX_QUESTION_IMAGES=4
RAG_MAX_QUESTION_IMAGE_BYTES=5242880
RAG_SEARCH_TOP_K=5
RAG_QUESTION_IMAGE_TTL_HOURS=24
RAG_MAX_VISION_IMAGES=4
RAG_USER_IMAGE_RETRIEVAL=none

# 补偿任务
RAG_SWEEP_ENABLED=1
RAG_SWEEP_INTERVAL_SEC=60
RAG_PENDING_STALE_SEC=600
RAG_MAX_REQUEUE=2

# 前端与公开地址
RAG_FRONTEND_DIR=./frontend
API_PUBLIC_BASE_URL=http://127.0.0.1:8000
