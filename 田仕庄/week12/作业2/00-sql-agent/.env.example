# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交

# ---- LLM（必填）----
# DeepSeek 官方：https://api.deepseek.com
# 若用中转/自建网关，改成对应地址
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：模型覆盖（默认见 src/sql_agent/config.py）
# 当前有效模型名：deepseek-flash（DeepSeek-V4.1-Flash-1017）/ deepseek-v4-pro（更强更贵）
# 注意：deepseek-v4-flash 是"模型已下线的旧名"，deepseek-chat/reasoner 已于 2026-07-24 弃用
# SQL_AGENT_MODEL=deepseek-flash
# SQL_AGENT_SUMMARY_MODEL=deepseek-flash

# 思考模式：auto（默认，不传参，=服务端默认开启且 effort=high）
#           disabled（关闭，显著降低延迟与费用）
#           enabled（显式开启）
# 思考模式下 temperature 不生效，这是服务端行为，不是本项目 bug
# SQL_AGENT_THINKING=auto

# ---- LangSmith 追踪（可选）----
# 申请：https://smith.langchain.com → Settings → API Keys
# 不填则完全不上报，代码无需改动
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sql-agent

# ---- 运行参数（可选，默认值已够用）----
# 数据库位置：默认 ref/chinook.db（相对路径按项目根解析，与 cwd 无关）
# SQL_AGENT_DB=ref/chinook.db
# SQL_AGENT_MAX_REPAIR_ATTEMPTS=3
# SQL_AGENT_MAX_ROWS=200
# SQL_AGENT_MAX_SUMMARY_ROWS=50
# SQL_AGENT_QUERY_TIMEOUT=5.0
# SQL_AGENT_LLM_TIMEOUT=60.0
# SQL_AGENT_LLM_MAX_RETRIES=2
# SQL_AGENT_LOG_LEVEL=INFO
