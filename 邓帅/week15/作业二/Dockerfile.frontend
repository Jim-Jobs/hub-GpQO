# week15 作业二 · 前端镜像（多阶段：node + pnpm 构建 → nginx 静态托管 + /api 反代）
# build context = week15/：docker build -f 作业二/Dockerfile.frontend -t emotion-oa-frontend ..
# 前端 fetch("/api/chat") 为相对路径 → 经 nginx 反代打到网关，天然同源免 CORS。

FROM node:20-alpine AS build
WORKDIR /app
# pnpm 版本对齐 lockfileVersion 9.0（pnpm 9.x）；
# 容器网络不出代理：corepack 与 pnpm 均走 npmmirror
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY 作业一/openai-agents/frontend/package.json 作业一/openai-agents/frontend/pnpm-lock.yaml ./
RUN pnpm config set registry https://registry.npmmirror.com \
 && pnpm install --frozen-lockfile
COPY 作业一/openai-agents/frontend/ ./
RUN pnpm build

FROM nginx:alpine
COPY 作业二/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
