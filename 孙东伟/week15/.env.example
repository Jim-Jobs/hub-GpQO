# 复制成 .env 后填写；不填 Key 也能跑（自动 mock 模式）。
# 兼容 OpenAI 协议的服务（DeepSeek / 通义千问 / vLLM…）改 BASE_URL + MODEL 即可。

# live：真实模型；mock：强制离线规则引擎；auto：有 Key 就 live
APP_MODE=auto

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# 后端默认引擎：langgraph | agents
DEFAULT_ENGINE=langgraph
